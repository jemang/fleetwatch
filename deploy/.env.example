# Copy to .env next to docker-compose.yml and edit. Compose reads it on every
# command. Keep .env private: it holds the dashboard password.

# Dashboard password (required), at least 12 characters. Read only on the
# first start; change it later in Settings.
FLEETWATCH_ADMIN_PASSWORD=change-me

# Address agents and browsers use to reach the Hub. Install lines are built
# from it. Passkeys need https:// with a host name (or http://localhost).
FLEETWATCH_PUBLIC_URL=http://192.168.1.10:8080

# Reverse proxy in front of the Hub: its addresses or networks, separated by
# commas. Only from these is X-Forwarded-For believed, so login limits count
# the real visitor instead of the proxy. Example for a proxy on the same
# Docker host: the bridge network of this Compose project, 172.20.0.0/16.
#FLEETWATCH_TRUSTED_PROXIES=172.20.0.0/16

# Port on the Docker host.
FLEETWATCH_PORT=8080

# Image tag to run: a release number, or latest. When building from source
# it is also the version stamped into the Hub and the agent files.
FLEETWATCH_VERSION=latest

# Serve HTTPS directly: paths inside the container. Mount the files with an
# extra volume line in docker-compose.yml, or put a reverse proxy in front.
#FLEETWATCH_TLS_CERT=/certs/fullchain.pem
#FLEETWATCH_TLS_KEY=/certs/privkey.pem

# How long history is kept (Go durations, hours at most: 168h = 7 days).
#FLEETWATCH_RETENTION_RAW=24h
#FLEETWATCH_RETENTION_1M=168h
#FLEETWATCH_RETENTION_5M=720h
#FLEETWATCH_RETENTION_1H=8760h
#FLEETWATCH_RETENTION_SVC_RAW=168h
#FLEETWATCH_RETENTION_SVC_1H=2160h

# Time zone for times in alert messages (Telegram, webhook text). The pages
# show times in the browser's zone regardless.
#TZ=Asia/Singapore
